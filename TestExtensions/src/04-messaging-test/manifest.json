{
  "manifest_version": 3,
  "name": "Messaging Test",
  "version": "1.0",
  "description": "Tests popup -> background and background -> content script messaging.",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Messaging Test" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
